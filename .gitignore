# macOS
.DS_Store
.AppleDouble
.LSOverride

# Environment variables / local secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
.venv/
venv/
env/
ENV/

# Test, lint, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
wheels/

# Logs
.logs/
*.log
*.log.*

# Local/generated data
.data/
data/
outputs/
artifacts/
tmp/
temp/

# IDEs and editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.code-workspace

# Local tooling/configuration
.launchd/

# Node tooling, if used for a frontend or scripts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*